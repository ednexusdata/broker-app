<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.*" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.9.*" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EdNexusData.Broker.Core\EdNexusData.Broker.Core.csproj" />
    <!-- Built first, but loaded at runtime like a real connector: see CopyTestConnector below. -->
    <ProjectReference Include="..\EdNexusData.Broker.Connector.TestConnector\EdNexusData.Broker.Connector.TestConnector.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyTestConnector" AfterTargets="Build">
    <ItemGroup>
      <TestConnectorFiles Include="..\EdNexusData.Broker.Connector.TestConnector\bin\$(Configuration)\$(TargetFramework)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestConnectorFiles)" DestinationFolder="$(OutDir)TestConnector" SkipUnchangedFiles="true" />
  </Target>

</Project>
